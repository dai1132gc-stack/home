# ============================================================
# realestate-server 环境变量示例（复制为 .env 后填写真实值）
# .env 不提交 Git；真实密钥只允许保存在本地 .env 或系统环境变量
# ============================================================

# --- 数据库（MySQL 8，本地开发）---
DB_URL=jdbc:mysql://127.0.0.1:3306/realestate?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=realestate_dev
DB_PASSWORD=changeme

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# --- JWT（生产必须替换为强随机值，Access/Refresh 独立密钥）---
# 生成示例：openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- CORS（逗号分隔的明确 Origin，禁止 *）---
CORS_ALLOWED_ORIGINS=http://localhost:5174

# --- 启动引导账号（首次启动时表为空才生效）---
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_CUSTOMER_PASSWORD=

# --- 微信小程序 code 登录（W5；留空则降级为账号密码登录，接口返回 503）---
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_MINI_TIMEOUT_SECONDS=4

# --- 媒体存储（W2）---
# local：dev 本地磁盘；oss：生产切换对象存储（W4 接入实现）
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=uploads
STORAGE_PUBLIC_BASE_URL=/uploads
STORAGE_MAX_IMAGE_SIZE_BYTES=10485760
