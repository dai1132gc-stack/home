# ============================================================
# realestate-server 环境变量示例（复制为 .env 后填写真实值）
# .env 不提交 Git；真实密钥只允许保存在本地 .env 或系统环境变量
# ============================================================

# --- 数据库（MySQL 8，本地开发）---
DB_URL=jdbc:mysql://127.0.0.1:3306/realestate?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=realestate_dev
DB_PASSWORD=changeme

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# --- JWT（生产必须替换为强随机值）---
# 生成示例：openssl rand -base64 48
# JWT_ACCESS_SECRET 用于 Access Token 签名（算法按密钥长度自动选择 HS256/384/512，≥32 字节）
# JWT_REFRESH_SECRET 为历史兼容/预留：Refresh Token 是不透明随机串，该密钥不参与签名（V6.0.1 F8）
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- CORS（逗号分隔的明确 Origin，禁止 *）---
CORS_ALLOWED_ORIGINS=http://localhost:5174

# --- Web Refresh Cookie Secure（V6.0.1；dev=false，prod 必须 true）---
APP_COOKIE_SECURE=

# --- 启动引导账号（首次启动时表为空才生效）---
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_CUSTOMER_PASSWORD=

# --- 微信小程序 code 登录（W5；留空则降级为账号密码登录，接口返回 503）---
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_MINI_TIMEOUT_SECONDS=4

# --- 媒体存储（W2）---
# local：dev 本地磁盘；oss：生产切换对象存储（W4 接入实现）
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=uploads
STORAGE_PUBLIC_BASE_URL=/uploads
STORAGE_MAX_IMAGE_SIZE_BYTES=10485760

# --- AI 智能服务（W6；enabled=false 时以下均可留空，AI 能力自动降级）---
# OpenAI 兼容接口（/chat/completions、/embeddings）；Key 只允许保存在本地 .env，禁止提交/打印
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
AI_TIMEOUT_MS=12000
AI_MAX_INPUT_CHARS=200
AI_MAX_OUTPUT_TOKENS=800
AI_DAILY_TOKEN_LIMIT=100000
AI_RATE_LIMIT_PER_MINUTE=20
AI_TOP_K=4
AI_SIMILARITY_THRESHOLD=0.30
AI_CONCURRENCY=4
