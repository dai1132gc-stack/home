<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.realestate.modules.house.mapper.HouseMediaMapper">

    <select id="selectFirstImages" resultType="com.example.realestate.modules.house.model.vo.HouseCover">
        SELECT t.house_id, t.url
        FROM (
            SELECT house_id,
                   url,
                   ROW_NUMBER() OVER (PARTITION BY house_id ORDER BY sort ASC, id ASC) AS rn
            FROM house_media
            WHERE media_type = 'IMAGE'
              AND house_id IN
            <foreach collection="houseIds" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        ) t
        WHERE t.rn = 1
    </select>

</mapper>
