.page { padding: 24rpx; }
.ask-bar { display: flex; flex-direction: column; gap: 16rpx; }
.input { background: #f5f6f8; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; min-height: 120rpx; width: 100%; box-sizing: border-box; }
.btn { background: #2b6de5; color: #fff; font-size: 28rpx; border-radius: 12rpx; }
.btn[disabled] { opacity: 0.6; }
.error { margin-top: 20rpx; color: #d4380d; font-size: 26rpx; }
.result { margin-top: 24rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; }
.answer { font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; }
.insufficient { color: #ad6800; font-size: 26rpx; }
.citations { margin-top: 24rpx; }
.cite-title { font-size: 26rpx; font-weight: 600; margin-bottom: 12rpx; }
.cite { background: #f8f9fb; border-radius: 12rpx; padding: 16rpx 20rpx; margin-bottom: 12rpx; }
.cite-head { font-size: 26rpx; font-weight: 500; }
.cite-source { color: #888; font-size: 22rpx; margin-top: 6rpx; }
.cite-snippet { color: #666; font-size: 24rpx; margin-top: 8rpx; }
.disclaimer { margin-top: 20rpx; color: #999; font-size: 22rpx; }
