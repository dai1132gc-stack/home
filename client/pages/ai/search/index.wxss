.page { padding: 24rpx; }
.search-bar { display: flex; gap: 16rpx; }
.input { flex: 1; background: #f5f6f8; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 28rpx; }
.btn { background: #2b6de5; color: #fff; font-size: 28rpx; border-radius: 12rpx; }
.btn[disabled] { opacity: 0.6; }
.degrade-tip { margin-top: 16rpx; background: #fff7e6; color: #ad6800; padding: 16rpx 20rpx; border-radius: 12rpx; font-size: 24rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.chip { background: #eaf1fe; color: #2b6de5; font-size: 22rpx; padding: 8rpx 16rpx; border-radius: 999rpx; }
.error { margin-top: 16rpx; color: #d4380d; font-size: 26rpx; display: flex; align-items: center; gap: 16rpx; }
.card { display: flex; gap: 20rpx; background: #fff; border-radius: 16rpx; padding: 20rpx; margin-top: 20rpx; }
.cover { width: 200rpx; height: 150rpx; border-radius: 12rpx; background: #eee; }
.info { flex: 1; }
.title { font-size: 30rpx; font-weight: 600; }
.meta { color: #888; font-size: 24rpx; margin-top: 8rpx; }
.price { color: #d4380d; font-size: 30rpx; margin-top: 12rpx; }
.type { color: #888; font-size: 22rpx; margin-left: 12rpx; }
.foot, .empty { text-align: center; color: #999; font-size: 24rpx; margin-top: 32rpx; }
