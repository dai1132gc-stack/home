/**pages/repair/list/index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f6f8;
}
.page {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.tabs {
  display: flex;
  background: #fff;
  padding: 8rpx 12rpx;
  gap: 6rpx;
}
.tab {
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  color: #6b7280;
  padding: 14rpx 0;
  border-radius: 12rpx;
}
.tab.active {
  color: #2b6de5;
  background: #eef4ff;
  font-weight: 600;
}
.list {
  flex: 1;
  height: 0;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}
.empty {
  padding-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  color: #8a9099;
  font-size: 27rpx;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  flex: 1;
}
.status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #f2f3f5;
  color: #6b7280;
}
.status-SUBMITTED {
  background: #fff7e8;
  color: #b26a00;
}
.status-PROCESSING,
.status-REOPENED {
  background: #eef4ff;
  color: #2b6de5;
}
.status-RESOLVED {
  background: #e8f8ee;
  color: #1f9d55;
}
.status-CLOSED {
  background: #f2f3f5;
  color: #6b7280;
}
.status-CANCELLED {
  background: #fdecec;
  color: #c0392b;
}
.meta {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #7b828c;
}
.bottom {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 18rpx;
}
.mini {
  border-radius: 32rpx;
  font-size: 24rpx;
  margin: 0;
}
.mini.ghost {
  background: #eef4ff;
  color: #2b6de5;
}
.mini.primary {
  background: #2b6de5;
  color: #fff;
}
.loading {
  text-align: center;
  font-size: 24rpx;
  color: #9aa0a8;
  padding: 20rpx 0;
}
.footer-space {
  height: 40rpx;
}
.retry {
  background: #eef4ff;
  color: #2b6de5;
}
