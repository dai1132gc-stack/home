/**pages/repair/create/index.wxss**/
page {
  background: #f5f6f8;
}
.scroll {
  height: 100vh;
}
.page {
  padding: 20rpx 24rpx 60rpx;
}
.state {
  padding-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  color: #8a9099;
  font-size: 28rpx;
}
.panel {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.house-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}
.meta {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #7b828c;
}
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.form-item:last-child {
  border-bottom: none;
}
.textarea-item {
  align-items: flex-start;
}
.label {
  font-size: 28rpx;
  color: #4a515b;
  min-width: 150rpx;
}
.value {
  font-size: 28rpx;
  color: #1f2329;
}
.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #1f2329;
}
.textarea {
  flex: 1;
  height: 160rpx;
  font-size: 27rpx;
  color: #1f2329;
  text-align: right;
}
.radio-group {
  display: flex;
  gap: 30rpx;
}
.radio {
  font-size: 27rpx;
  color: #4a515b;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 16rpx;
}
.images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.image-wrap {
  position: relative;
  width: 150rpx;
  height: 150rpx;
}
.shot {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
}
.remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
}
.add {
  width: 150rpx;
  height: 150rpx;
  border: 1rpx dashed #c9cdd4;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9aa0a8;
}
.add-plus {
  font-size: 44rpx;
  line-height: 1;
}
.add-text {
  font-size: 22rpx;
  margin-top: 6rpx;
}
.hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9aa0a8;
}
.tip {
  font-size: 23rpx;
  color: #9aa0a8;
  line-height: 1.6;
  padding: 8rpx 8rpx 24rpx;
}
.submit {
  border-radius: 44rpx;
  font-size: 30rpx;
  background: #2b6de5;
  color: #fff;
}
.retry {
  background: #eef4ff;
  color: #2b6de5;
}
