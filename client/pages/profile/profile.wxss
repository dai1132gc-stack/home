/* pages/profile/profile.wxss */
.scrollarea {
  height: 100vh;
}
.profile-wrap {
  padding: 40rpx 32rpx;
}
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 60rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.row:last-child {
  border-bottom: none;
}
.k {
  color: #888;
  font-size: 28rpx;
}
.v {
  color: #333;
  font-size: 28rpx;
}
.empty {
  text-align: center;
  color: #aaa;
  padding: 80rpx 0;
}
.logout {
  width: 100%;
}
