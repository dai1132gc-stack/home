/**pages/content/list/index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f6f8;
}
.page {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.tabs {
  display: flex;
  background: #fff;
  padding: 8rpx 12rpx;
  gap: 8rpx;
}
.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
  padding: 14rpx 0;
  border-radius: 12rpx;
}
.tab.active {
  color: #2b6de5;
  background: #eef4ff;
  font-weight: 600;
}
.list {
  flex: 1;
  height: 0;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}
.empty {
  padding-top: 160rpx;
  text-align: center;
  color: #8a9099;
  font-size: 27rpx;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
}
.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  flex: 1;
  line-height: 1.5;
}
.badge {
  font-size: 21rpx;
  color: #2b6de5;
  background: #eef4ff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.summary {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #5b626c;
  line-height: 1.7;
}
.meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9aa0a8;
}
.loading {
  text-align: center;
  font-size: 24rpx;
  color: #9aa0a8;
  padding: 20rpx 0;
}
.footer-space {
  height: 40rpx;
}
