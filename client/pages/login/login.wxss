/* pages/login/login.wxss */
.scrollarea {
  height: 100vh;
}
.login-wrap {
  padding: 80rpx 48rpx;
  display: flex;
  flex-direction: column;
}
.brand {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 80rpx;
}
.field {
  margin-bottom: 32rpx;
}
.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.input {
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}
.submit {
  margin-top: 40rpx;
}
.hint {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: #aaa;
  text-align: center;
}
