/* pages/login/login.wxss */
.scrollarea {
  height: 100vh;
}
.login-wrap {
  padding: 80rpx 48rpx;
  display: flex;
  flex-direction: column;
}
.brand {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 80rpx;
}
.field {
  margin-bottom: 32rpx;
}
.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.input {
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}
.submit {
  margin-top: 40rpx;
}
.wechat {
  margin-top: 0;
}
.wechat-hint {
  margin-top: 16rpx;
}
.divider {
  margin: 56rpx 0 40rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}
.divider::before,
.divider::after {
  content: '';
  display: inline-block;
  width: 80rpx;
  height: 1rpx;
  background: #e0e0e0;
  vertical-align: middle;
  margin: 0 16rpx;
}
.hint {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: #aaa;
  text-align: center;
}
