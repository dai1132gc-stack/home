<!--pages/appointment/list/index.wxml-->
<navigation-bar title="我的预约" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<view class="page">
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="value"
      class="tab {{status === item.value ? 'active' : ''}}"
      data-status="{{item.value}}"
      bindtap="switchStatus"
    >{{item.label}}</view>
  </view>

  <scroll-view class="list" scroll-y type="list" bindscrolltolower="onScrollToLower" lower-threshold="120">
    <view wx:if="{{!loggedIn}}" class="empty">
      <text>登录后查看预约</text>
      <button size="mini" class="retry" bindtap="goLogin">去登录</button>
    </view>

    <view wx:elif="{{error}}" class="empty">
      <text>{{error}}</text>
      <button size="mini" class="retry" bindtap="goLogin" wx:if="{{!items.length}}">去登录</button>
    </view>

    <view wx:elif="{{items.length === 0 && !loading}}" class="empty">
      <text>还没有预约记录</text>
      <button size="mini" class="retry" bindtap="goHouses">去看看房源</button>
    </view>

    <view class="card" wx:for="{{items}}" wx:key="id">
      <view class="row">
        <text class="title">{{item.houseTitle || '房源已下架'}}</text>
        <text class="status status-{{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="meta">{{item.houseRegion}} · {{item.houseCommunity}}</view>
      <view class="meta">看房时间：{{item.timeText}}</view>
      <view class="meta">联系电话：{{item.contactPhone}}</view>
      <view class="meta" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
      <view class="bottom">
        <text class="created">提交于 {{item.createdText}}</text>
        <button
          wx:if="{{item.canCancel}}"
          class="cancel"
          size="mini"
          data-id="{{item.id}}"
          loading="{{acting}}"
          bindtap="cancel"
        >取消预约</button>
      </view>
    </view>

    <view class="loading" wx:if="{{loading}}">加载中…</view>
    <view class="loading" wx:elif="{{finished && items.length > 0}}">没有更多了</view>
    <view class="footer-space"></view>
  </scroll-view>
</view>
