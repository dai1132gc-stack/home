/**pages/house/detail/index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f6f8;
}
.page {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: #8a9099;
  font-size: 28rpx;
}
.body {
  flex: 1;
  height: 0;
}
.gallery {
  width: 100%;
  height: 440rpx;
  background: #eceff3;
}
.gallery-img {
  width: 100%;
  height: 100%;
}
.gallery.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #aab0b8;
  font-size: 26rpx;
}
.panel {
  background: #fff;
  margin: 20rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 28rpx;
}
.headline {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.price {
  color: #e64340;
  font-size: 44rpx;
  font-weight: 700;
}
.badge {
  font-size: 22rpx;
  color: #2b6de5;
  background: #eef4ff;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.title {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
}
.meta {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #7b828c;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 20rpx;
}
.grid {
  display: flex;
}
.cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.cell-value {
  font-size: 30rpx;
  color: #1f2329;
  font-weight: 600;
}
.cell-label {
  font-size: 24rpx;
  color: #8a9099;
}
.desc {
  font-size: 28rpx;
  color: #4a515b;
  line-height: 1.7;
  white-space: pre-wrap;
}
.tip {
  margin: 20rpx 24rpx 0;
  font-size: 22rpx;
  color: #9aa0a8;
  text-align: center;
}
.footer-space {
  height: 40rpx;
}
.actions {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}
.fav {
  flex: 1;
  border-radius: 44rpx;
  font-size: 30rpx;
  background: #eef4ff;
  color: #2b6de5;
  border: none;
}
.fav.on {
  background: #2b6de5;
  color: #fff;
}
.book {
  flex: 1;
  border-radius: 44rpx;
  font-size: 30rpx;
  background: #ff6a00;
  color: #fff;
  border: none;
}
.repair {
  flex: 0 0 130rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  background: #f2f3f5;
  color: #4a515b;
  border: none;
}
