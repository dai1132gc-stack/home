<!--index.wxml-->
<navigation-bar title="房产中介" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <view class="title">房产中介管理系统</view>
    <view class="subtitle">小程序端 · 客户</view>

    <button class="btn house-entry" type="primary" data-tab="all" bindtap="goHouses">浏览房源</button>

    <view class="entry-grid">
      <button class="entry" bindtap="goGuides">租房指南</button>
      <button class="entry" data-category="NOTICE" bindtap="goGuides">公告</button>
      <button class="entry" bindtap="goPolicies">政策文件</button>
      <button class="entry" bindtap="goCalculator">房贷计算</button>
    </view>

    <view wx:if="{{loading}}" class="status">正在恢复会话…</view>

    <block wx:elif="{{loggedIn}}">
      <view class="status">
        <text>已登录：{{user.nickname || user.username}}</text>
      </view>
      <view class="role">角色：{{user.role}}</view>
      <button class="btn" data-tab="fav" bindtap="goHouses">我的收藏</button>
      <button class="btn" bindtap="goAppointments">我的预约</button>
      <button class="btn" bindtap="goContracts">我的合同</button>
      <button class="btn" bindtap="goRepairs">我的报修</button>
      <button class="btn" bindtap="goProfile" type="primary">进入个人中心</button>
    </block>

    <block wx:else>
      <view class="status">未登录</view>
      <button class="btn" bindtap="goLogin" type="primary">账号密码登录</button>
    </block>
  </view>
</scroll-view>
