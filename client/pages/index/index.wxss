/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}
.title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.subtitle {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 60rpx;
}
.house-entry {
  margin-bottom: 40rpx;
}
.status {
  font-size: 30rpx;
  margin-bottom: 16rpx;
}
.role {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 60rpx;
}
.btn {
  width: 80%;
}
