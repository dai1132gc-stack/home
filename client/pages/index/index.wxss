/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}
.title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.subtitle {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 60rpx;
}
.house-entry {
  margin-bottom: 24rpx;
}
.entry-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  width: 100%;
  margin-bottom: 32rpx;
}
.entry {
  width: calc(50% - 8rpx);
  margin: 0;
  font-size: 26rpx;
  background: #fff;
  color: #2b6de5;
  border: 1rpx solid #e3ebfb;
  border-radius: 14rpx;
}
.status {
  font-size: 30rpx;
  margin-bottom: 16rpx;
}
.role {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 60rpx;
}
.btn {
  width: 80%;
}
